{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "JobPulse (local backend)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    },
    {
      "name": "JobPulse (production API)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": ["--dart-define=USE_PROD_API=true"]
    },
    {
      "name": "JobPulse (local backend, physical device)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": ["--dart-define=API_HOST=192.168.1.42"]
    }
  ]
}
